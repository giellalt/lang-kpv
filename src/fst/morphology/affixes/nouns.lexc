
! ============================= !
!! # Noun morphological lexica 
! ============================= !

! ===== !
! Nouns 
! ===== !

LEXICON Vocative   !!≈ * **@CODE@**
+Voc: # ;

LEXICON Noun1_IS_PTC_OM !!≈ * **@CODE@** is to provide deverbal nouns with +Der/wm tags
!+V+Der+Der/wm: NMN_ ; 2026-07-01
 NMN_ ;

LEXICON Noun1_IS_PTC_AN !!≈ * **@CODE@**
+V+Der+Der/An: NMN_ ;

LEXICON Noun1_IS_PTC_YSJ !!≈ * **@CODE@**
!+V+Der+Der/ysj: NMN_ ; 2026-07-01
NMN_ ;

LEXICON N_DOR ! мӧдладор The Russian is an adverbial phrase
!+Der+Der/dor: NMN_ ; 2026-06-30
 NMN_ ;

LEXICON N_LA
+Der/La: NMN_ ;

LEXICON N_VYV ! тулысвыв The Russian is an adverbial phrase
!+Der+Der/vyv: NMN_ ; 2026-06-30
 NMN_ ;

LEXICON N_rus100 ! Homographs
+Src/F: NMN_ ;
!LEXICON N_ruskpv ! Komi-like Russian words
!+Src/F: NMN_ ;

LEXICON N_rus100_hasnat ! Homographs
+Src/F: NMN_ ;
LEXICON N_ruskpv_hasnat ! Komi-like Russian words
+Src/F: NMN_ ;


LEXICON N_ruskpv_R_RY_hasnat !
+Use/NG+Err/Orth: NMN_ ;  ! This deals with январь

LEXICON Noun1_SYT_STY !
+Use/NG+Err/Orth:ть NMN_ ;  ! This deals with гӧсть
:ьт         NMN_ ; ! This is the new proper spelling гӧсьт


!2018-10-21!LEXICON N_KINDRED_
!2018-10-21! N_ ;
!2018-10-21!+PxSg1+Assoc+Pl:%>ӧяс CASEPOSSLEX ;
!2018-10-21!+PxSg2+Assoc+Pl:%>ыдъяс CASEPOSSLEX ;
!2018-10-21!+PxSg3+Assoc+Pl:%>ысъяс CASEPOSSLEX ;

!2018-10-21!LEXICON N_PROFESSION_
!2018-10-21! N_ ;
!2018-10-21!@C.CONJ_INF@@C.CONJ-POSS@+Der+Der/al:@C.CONJ_INF@@C.CONJ-POSS@%>{ая}л V_ШУНЫ ; !! таксисталӧ 
!! Basic nouns.

!! The lexicon for basic nouns is ` N_ `



LEXICON N_errorth
+Err/Orth: N_ ;
LEXICON N_RELAT_
+Relat: NMN_ ;
LEXICON N_
+Der+Dimin+N:%>тор N_PARAGOGIC_J ;
: NMN_ ;

LEXICON Noun1 !! This should be phased out 2013-05-07
 N_ ;
LEXICON N_RU_ӦЙ
+Use/SpellNoSugg:  N_ ;

LEXICON NMN_
 R ;
! ABS_ ; 2018-10-21
@U.DECL-NX.SG@+Sg:@U.DECL-NX.SG@ CASEPOSSLEX ;
@U.DECL-NX.PL@+Pl:@U.DECL-NX.PL@%>ъяс CASEPOSSLEX ;


!LEXICON Noun1_JM ! понйыс, понмыс
!+Use/NG:м CASEPOSSLEX_AFTERDERIVATION_VOW ;
!!2017-09-19+Cmp:м R ;
!!2017-09-19+Sg:м CASEPOSSLEX ;
!!2017-09-19+Cmp:й R ;
!:й NMN_PARAGOGIC ;
!!2017-09-19+Sg:й CASEPOSSLEX ;
!!2017-09-19+Pl:%>ъяс CASEPOSSLEX ;

!! subsequent Cns vs Vow
LEXICON N_PARAGOGIC !!= * @CODE@ 
: NMN_PARAGOGIC ;
LEXICON NMN_PARAGOGIC !!= * @CODE@ 
+Cmp:^Close R ;
!:^Close ABS_ ; 2018-10-21
@U.DECL-NX.SG@+Sg:@U.DECL-NX.SG@^Close CASEPOSSLEX_AFTERDERIVATION_CNS/END ;
@U.DECL-NX.SG@+Sg:@U.DECL-NX.SG@ CASEPOSSLEX_AFTERDERIVATION_VOW ;
@U.DECL-NX.SG@+Sg:@U.DECL-NX.SG@^Close DERIVEDADJ_IN_CONS ;
@U.DECL-NX.SG@+Sg:@U.DECL-NX.SG@ DERIVEDADJ_IN_VOW ;

@U.DECL-NX.PL@+Pl:@U.DECL-NX.PL@^Close%>ъяс CASEPOSSLEX ;

!Izhma style
@U.DECL-NX.SG@+Sg+Err/Dial:@U.DECL-NX.SG@^C2V CASEPOSSLEX_AFTERDERIVATION_CNS/END ;
@U.DECL-NX.SG@+Sg+Err/Dial:@U.DECL-NX.SG@^C2V DERIVEDADJ_IN_CONS ;
@U.DECL-NX.PL@+Pl+Err/Dial:@U.DECL-NX.PL@^C2V%>ъяс CASEPOSSLEX ;


LEXICON N_RELAT_PARAGOGIC_V/L !!= * @CODE@ ныв:ны нылыс
+Relat: NMN_PARAGOGIC_V/L ;

LEXICON N_PARAGOGIC_V/L !!= * @CODE@ ныв:ны нылыс
: NMN_PARAGOGIC_V/L ;
LEXICON NMN_PARAGOGIC_V/L !!= * @CODE@ ныв:ны нылыс
:^л2 NMN_PARAGOGIC ;
@U.DECL-NX.SG@+Sg+Err/Orth-l-retention:@U.DECL-NX.SG@^л2 CASEPOSSLEX_AFTERDERIVATION_CNS/END ;
@U.DECL-NX.SG@+Sg+Err/Orth-l-retention:@U.DECL-NX.SG@^л2 DERIVEDADJ_IN_CONS ;

+Use/NG+Err/Orth-l-retention+Cmp:^л2 R ;
!+Err/Orth+Dial/l+Cmp:^л2 ABS_ ; 2018-10-21
@U.DECL-NX.SG@+Use/NG+Err/Orth-l-retention+Sg:@U.DECL-NX.SG@^л2 CASEPOSSLEX_AFTERDERIVATION_CNS/END ;
@U.DECL-NX.SG@+Use/NG+Err/Orth-l-in-v+Sg:@U.DECL-NX.SG@^л2^Close CASEPOSSLEX_AFTERDERIVATION_VOW ;
@U.DECL-NX.PL@+Use/NG+Err/Orth-l-retention+Pl:@U.DECL-NX.PL@^л2%>ъяс CASEPOSSLEX ;
@U.DECL-NX.PL@+Use/NG+Err/Orth-l-to-vowel-lengthening+Pl:@U.DECL-NX.PL@^л2^C2V%>ъяс CASEPOSSLEX ; !ныыяс


LEXICON N_PARAGOGIC_J !!= * @CODE@ ав:ав авйыс
: NMN_PARAGOGIC_J ;
LEXICON NMN_PARAGOGIC_J !!= * @CODE@ ав:ав^й2 авйыс
:^й2 NMN_PARAGOGIC ;
@U.DECL-NX.SG@+Use/NG+Sg+Err/Orth-no-paragogic-j:@U.DECL-NX.SG@^й2^Close CASEPOSSLEX_AFTERDERIVATION_VOW ;
@U.DECL-NX.SG@+Use/NG+Sg+Err/Orth-no-paragogic-j:@U.DECL-NX.SG@^й2^Close DERIVEDADJ_IN_VOW ;

LEXICON N_PARAGOGIC_K !!= * @CODE@ пос:пос^к2 поскыс
: NMN_PARAGOGIC_K ;
LEXICON NMN_PARAGOGIC_K !!= * @CODE@ пос:пос^к2 поскыс
:^к2 NMN_PARAGOGIC ;
@U.DECL-NX.SG@+Use/NG+Sg+Err/Orth-no-paragogic-k:@U.DECL-NX.SG@^к2^Close CASEPOSSLEX_AFTERDERIVATION_VOW ;
@U.DECL-NX.SG@+Use/NG+Sg+Err/Orth-no-paragogic-k:@U.DECL-NX.SG@^к2^Close DERIVEDADJ_IN_VOW ;

LEXICON N_PARAGOGIC_M !!= * @CODE@ зон:зон зонмыс
: NMN_PARAGOGIC_M ;
LEXICON NMN_PARAGOGIC_M !!= * @CODE@ зон:зон зонмыс
:^м2 N_PARAGOGIC ;
@U.DECL-NX.SG@+Use/NG+Sg+Err/Orth-no-paragogic-m:@U.DECL-NX.SG@^м2^Close CASEPOSSLEX_AFTERDERIVATION_VOW ;
@U.DECL-NX.SG@+Use/NG+Sg+Err/Orth-no-paragogic-m:@U.DECL-NX.SG@^м2^Close DERIVEDADJ_IN_VOW ;

LEXICON N_PARAGOGIC_T !!= * @CODE@ зеп:зеп зептыс
: NMN_PARAGOGIC_T ;
LEXICON NMN_PARAGOGIC_T !!= * @CODE@ зеп:зеп зептыс
:^т2 N_PARAGOGIC ;
@U.DECL-NX.SG@+Use/NG+Sg+Err/Orth-no-paragogic-t:@U.DECL-NX.SG@^т2^Close CASEPOSSLEX_AFTERDERIVATION_VOW ;
@U.DECL-NX.SG@+Use/NG+Sg+Err/Orth-no-paragogic-t:@U.DECL-NX.SG@^т2^Close DERIVEDADJ_IN_VOW ;

LEXICON N_END_IN_DD1 !!= * @CODE@ гадь:гад гаддьыс
: NMN_END_IN_DD1 ;
LEXICON NMN_END_IN_DD1 !!= * @CODE@ автомобиль:автомобил автомобильыс
:дь NMN_PARAGOGIC ;

LEXICON N_END_IN_DDZ !!= * @CODE@ кыдз:кыд
: NMN_END_IN_DDZ ;
LEXICON NMN_END_IN_DDZ !!= * @CODE@ кыдз:кыд
:дз NMN_PARAGOGIC ;

LEXICON N_END_IN_LL1 !!= * @CODE@ моль:мол молльӧ
: NMN_END_IN_LL1 ;
LEXICON NMN_END_IN_LL1 !!= * @CODE@ моль:мол молльӧ
:ль NMN_PARAGOGIC ;



LEXICON N_RELAT_END_IN_J !!= * @CODE@ абай:аба абайыс
+Relat: N_0_END_IN_J ;
LEXICON N_END_IN_J !!= * @CODE@ абай:аба абайыс
: N_0_END_IN_J ;
LEXICON N_0_END_IN_J !!= * @CODE@ абай:аба абайыс
+Cmp:й R ;
!:й ABS_ ; 2018-10-21
@U.DECL-NX.SG@+Sg:@U.DECL-NX.SG@й CASEPOSSLEX_AFTERDERIVATION_CNS/END ;
@U.DECL-NX.SG@+Sg:@U.DECL-NX.SG@ CASEPOSSLEX_AFTERDERIVATION_Я ;
@U.DECL-NX.SG@+Sg:@U.DECL-NX.SG@й CASEPOSSLEX_AFTERDERIVATION_Ӧ ;
@U.DECL-NX.PL@+Pl:@U.DECL-NX.PL@й%>яс CASEPOSSLEX ;


LEXICON N_RELAT_END_IN_Ч/ДЗ !!= * @CODE@ водз:водз
+Relat: NMN_END_IN_Ч/ДЗ ;
LEXICON N_END_IN_Ч/ДЗ !!= * @CODE@ водз:водз
: NMN_END_IN_Ч/ДЗ ;
LEXICON NMN_END_IN_Ч/ДЗ !!= * @CODE@ водз:водз
+Cmp: R ;
!: ABS_ ; 2018-10-21
@U.DECL-NX.SG@+Sg:@U.DECL-NX.SG@ CASEPOSSLEX_AFTERDERIVATION_CNS/END ;
@U.DECL-NX.SG@+Sg:@U.DECL-NX.SG@ CASEPOSSLEX_AFTERDERIVATION_VOW ;
@U.DECL-NX.PL@+Pl:@U.DECL-NX.PL@%>ьяс CASEPOSSLEX ;

LEXICON N_RELAT_END_IN_Ь !!= * @CODE@ автомобиль:автомобил автомобильыс
+Relat:  N_0_END_IN_Ь ;
LEXICON N_END_IN_Ь !!= * @CODE@ автомобиль:автомобил автомобильыс
:  N_0_END_IN_Ь ;
LEXICON N_0_END_IN_Ь !!= * @CODE@ автомобиль:автомобил автомобильыс
+Cmp:ь R ;
!:ь ABS_ ; 2018-10-21
@U.DECL-NX.SG@+Sg:@U.DECL-NX.SG@ь CASEPOSSLEX_AFTERDERIVATION_CNS/END ;
@U.DECL-NX.SG@+Sg:@U.DECL-NX.SG@ CASEPOSSLEX_AFTERDERIVATION_Я ;
@U.DECL-NX.SG@+Sg:@U.DECL-NX.SG@ь CASEPOSSLEX_AFTERDERIVATION_Ӧ ;
@U.DECL-NX.PL@+Pl:@U.DECL-NX.PL@%>ьяс CASEPOSSLEX ; !! 2015-09-04 change to ь%>яс after xfst rules are removed
@U.DECL-NX.SG@+Sg:@U.DECL-NX.SG@ь DERIVEDADJ ;
@U.DECL-NX.PL@+Pl:@U.DECL-NX.PL@%>ьяс DERIVEDADJ ;

!2018-10-21!LEXICON NounLA ! ӧтила
!2018-10-21!N_ ; ! Difference betw N_ and NounLA still to be documented.

!LEXICON NounMort
! медводзаысь гӧгӧрвои, мый ӧтика лыдын морт, уна лыдын йӧз
! http://komicorpora.ru/index.php#poisk мортъяс => 503
! Сідзи кӧ позяс бырӧдны NounMort LEXICON_сӧ
!N_ ; ! Difference betw N_ and NounMort still to be documented.
! Бырӧдім 2019-06-14

!LEXICON NounSG ! м орт
!+Sg: CASEPOSSLEX ;

LEXICON NounPi ! пи These have a unique  pl marker ян.
@U.DECL-NX.SG@+Sg:@U.DECL-NX.SG@ CASEPOSSLEX ;
@U.DECL-NX.PL@+Pl:@U.DECL-NX.PL@%>ян CASEPOSSLEX ;


LEXICON NounPL_plc ! бедьторъяс
+Sem/Plc: NounPL ;
LEXICON NounPL ! бедьторъяс
@U.DECL-NX.PL@+Pl:@U.DECL-NX.PL@ CASEPOSSLEX ; ! here, %>ъяс is put as part of the stem
! Very many plural nouns do not have this tag. We could change яс-final
! nouns from N_ to NounPL, I guess.

!2018-10-21!LEXICON NounPOSS ! чой niece, nephew
!2018-10-21!N_ ; ! Declension to be determined.

LEXICON FIRST
+Cmp: # ;


! =================== !
!! ## Inflectional lexica
! =================== !


!! All nouns follow one contlex "N_"
!! to begin with here is simply a list of all variant
!! with no more variants beyond:

! Numbers
! Case + Poss or Poss+Case


LEXICON CASEPOSSLEX !!≈ * **@CODE@**
 DERIVEDADJ ;    ! Deriving prenominal adjectives, республикаса
CASEPOSSLEX_afterDerivation ;

LEXICON CASEPOSSLEX_afterDerivation
 CASEPOSSLEX_AFTERDERIVATION_CNS/END ;
  CASEPOSSLEX_AFTERDERIVATION_VOW ;

LEXICON CASEPOSSLEX_AFTERDERIVATION_CNS/END
@U.DECL-CX.NOM@@U.DECL-PX.SG1@+Nom+PxSg1:@U.DECL-CX.NOM@@U.DECL-PX.SG1@%>ӧ WordEnd ;!2026-06-10
! NOM/MORPH_THEN_WORDEND ;
@U.DECL-CX.NOM@@D.DECL-PX@+Nom:@U.DECL-CX.NOM@@D.DECL-PX@ K ;
!2020-10-23 remove ZERO +Acc: K ; !ZERO marker
@U.DECL-CX.GEN@+Gen+MWN:@U.DECL-CX.GEN@%>лӧн CASEPOSSLEX_AFTERDERIVATION_CNS/END_MINUS_ZERO_END ; !Ellipsis OKK:2000:94
	CASEPOSSLEX_AFTERDERIVATION_CNS/END_MINUS_ZERO_END ;
LEXICON CASEPOSSLEX_AFTERDERIVATION_CNS/END_MINUS_ZERO_END
@U.DECL-CX.GEN@+Gen:@U.DECL-CX.GEN@%>лӧн PredMonLex_Spat_Add_Morphology ;
@U.DECL-CX.GEN@+Use/NG+Err/Orth-e-not-oe+Gen:@U.DECL-CX.GEN@%>лэн K/COP_PL ;
@U.DECL-CX.ABL@+Abl:@U.DECL-CX.ABL@%>лысь COMPARATIVE ;
@U.DECL-CX.DAT@+Dat:@U.DECL-CX.DAT@%>лы COMPARATIVE ;
@U.DECL-CX.COM@+Com:@U.DECL-CX.COM@%>кӧд COMPARATIVE ;
@U.DECL-CX.COM@+Use/NG+Err/Orth-e-not-oe+Com:@U.DECL-CX.COM@%>кед COMPARATIVE ;
@U.DECL-CX.CAR@+Car:@U.DECL-CX.CAR@%>тӧг K ;
@U.DECL-CX.CAR@+Use/NG+Err/Orth-e-not-oe+Car:@U.DECL-CX.CAR@%>тэг K ;
@U.DECL-CX.CNS@+Cns:@U.DECL-CX.CNS@%>ла COMPARATIVE ;
@U.DECL-CX.ABE@+Abe:@U.DECL-CX.ABE@%>тӧм SPAT_COMPARATIVE ;! Case 2021-04-04 adnominal modifiers
@U.DECL-CX.LOC@+Loc:@U.DECL-CX.LOC@%>са SPAT_COMPARATIVE ;! Case 2021-04-04 adnominal modifiers
@U.DECL-CX.CMPR@+Cmpr:@U.DECL-CX.CMPR@%>ся SPAT_COMPARATIVE ;! Case 2021-04-04 adnominal modifiers
@U.DECL-CX.PRP@+Prp:@U.DECL-CX.PRP@%>{ая} SPAT_COMPARATIVE ;! Case 2021-04-04 adnominal modifiers
@U.DECL-CX.APR@+Apr:@U.DECL-CX.APR@%>лань SPAT_COMPARATIVE ;
@U.DECL-CX.EGR@+Egr:@U.DECL-CX.EGR@%>сянь SPAT_COMPARATIVE ;
@U.DECL-CX.TRA@+Tra:@U.DECL-CX.TRA@%>ті SPAT_COMPARATIVE ;
@U.DECL-CX.APRINE@+AprIne:@U.DECL-CX.APRINE@%>ланьын SPAT_COMPARATIVE ;  ! New cases in last grammar
@U.DECL-CX.APRELA@+AprEla:@U.DECL-CX.APRELA@%>ланьысь SPAT_COMPARATIVE ;  !
@U.DECL-CX.APRILL@+AprIll:@U.DECL-CX.APRILL@%>ланьӧ IllCompar ; !
@U.DECL-CX.APRILL@+Use/NG+Err/Orth-e-not-oe+AprIll:@U.DECL-CX.APRILL@%>лане IllCompar ; !
@U.DECL-CX.APREGR@+AprEgr:@U.DECL-CX.APREGR@%>ланьсянь SPAT_COMPARATIVE ; !
@U.DECL-CX.APRPRL@+AprPrl:@U.DECL-CX.APRPRL@%>ланьӧд SPAT_COMPARATIVE ; !
@U.DECL-CX.APRPRL@+Use/NG+Err/Orth-e-not-oe+AprPrl:@U.DECL-CX.APRPRL@%>ланед K ; !
@U.DECL-CX.APRTRA@+AprTra:@U.DECL-CX.APRTRA@%>ланьті SPAT_COMPARATIVE ; !
@U.DECL-CX.APRTER@+AprTer:@U.DECL-CX.APRTER@%>ланьӧдз K ; ! Tähän asti
@U.DECL-CX.APRTER@+Use/NG+Err/Orth-e-not-oe+AprTer:@U.DECL-CX.APRTER@%>ланедз K ; ! Tähän asti
!! SG1
 ACC_PXSG1/MORPH_THEN_WORDEND ;
@U.DECL-CX.COM@@U.DECL-PX.SG1@+Com+PxSg1+So/PC:@U.DECL-CX.COM@@U.DECL-PX.SG1@%>ӧкӧд COMPARATIVE ;
@U.DECL-CX.INS@@U.DECL-PX.SG1@+Ins+PxSg1+So/CP:@U.DECL-CX.INS@@U.DECL-PX.SG1@%>нам COMPARATIVE ;
@U.DECL-CX.ELA@@U.DECL-PX.SG1@+Ela+PxSg1+So/CP:@U.DECL-CX.ELA@@U.DECL-PX.SG1@%>сьым SPAT_COMPARATIVE ;
@U.DECL-CX.TRA@@U.DECL-PX.SG1@+Tra+PxSg1+So/CP:@U.DECL-CX.TRA@@U.DECL-PX.SG1@%>тіым COMPARATIVE ;
@U.DECL-CX.APR@@U.DECL-PX.SG1@+Apr+PxSg1+So/CP:@U.DECL-CX.APR@@U.DECL-PX.SG1@%>ланьым SPAT_COMPARATIVE ;
@U.DECL-CX.EGR@@U.DECL-PX.SG1@+Egr+PxSg1+So/CP:@U.DECL-CX.EGR@@U.DECL-PX.SG1@%>саньым SPAT_COMPARATIVE ;
@U.DECL-CX.APRINE@@U.DECL-PX.SG1@+AprIne+PxSg1+So/CP:@U.DECL-CX.APRINE@@U.DECL-PX.SG1@%>ланям SPAT_COMPARATIVE ;
@U.DECL-CX.APRELA@@U.DECL-PX.SG1@+AprEla+PxSg1+So/CP:@U.DECL-CX.APRELA@@U.DECL-PX.SG1@%>ланьсьым SPAT_COMPARATIVE ;
@U.DECL-CX.APRILL@@U.DECL-PX.SG1@+AprIll+PxSg1+So/CP:@U.DECL-CX.APRILL@@U.DECL-PX.SG1@%>ланям IllCompar ; !
@U.DECL-CX.APRPRL@@U.DECL-PX.SG1@+AprPrl+PxSg1+So/CP:@U.DECL-CX.APRPRL@@U.DECL-PX.SG1@%>ланьӧдым COMPARATIVE ;
@U.DECL-CX.APRPRL@@U.DECL-PX.SG1@+Use/NG+Err/Orth-e-not-oe+AprPrl+PxSg1+So/CP:@U.DECL-CX.APRPRL@@U.DECL-PX.SG1@%>ланедым K ;
@U.DECL-CX.APRTRA@@U.DECL-PX.SG1@+AprTra+PxSg1+So/CP:@U.DECL-CX.APRTRA@@U.DECL-PX.SG1@%>ланьтіым COMPARATIVE ;
@U.DECL-CX.APRTER@@U.DECL-PX.SG1@+AprTer+PxSg1+So/CP:@U.DECL-CX.APRTER@@U.DECL-PX.SG1@%>ланьӧдзым K ;
@U.DECL-CX.APRTER@@U.DECL-PX.SG1@+Use/NG+Err/Orth-e-not-oe+AprTer+PxSg1+So/CP:@U.DECL-CX.APRTER@@U.DECL-PX.SG1@%>ланедзым K ;

!! SG2
@U.DECL-CX.INS@@U.DECL-PX.SG2@+Ins+PxSg2+So/CP:@U.DECL-CX.INS@@U.DECL-PX.SG2@%>над COMPARATIVE ;
@U.DECL-CX.CAR@@U.DECL-PX.SG2@+Car+PxSg2+So/CP:@U.DECL-CX.CAR@@U.DECL-PX.SG2@%>тӧгыд K ;
@U.DECL-CX.CAR@@U.DECL-PX.SG2@+Use/NG+Err/Orth-e-not-oe+Car+PxSg2+So/CP:@U.DECL-CX.CAR@@U.DECL-PX.SG2@%>тэгыд K ;
@U.DECL-CX.COM@@U.DECL-PX.SG2@+Com+PxSg2+So/CP:@U.DECL-CX.COM@@U.DECL-PX.SG2@%>кӧдыд COMPARATIVE ;
@U.DECL-CX.COM@@U.DECL-PX.SG2@+Use/NG+Err/Orth-e-not-oe+Com+PxSg2+So/CP:@U.DECL-CX.COM@@U.DECL-PX.SG2@%>кедыд K ;
@U.DECL-CX.CMPR@@U.DECL-PX.SG2@+Cmpr+PxSg2+So/CP:@U.DECL-CX.CMPR@@U.DECL-PX.SG2@%>сяыд COMPARATIVE ;
@U.DECL-CX.ELA@@U.DECL-PX.SG2@+Ela+PxSg2+So/CP:@U.DECL-CX.ELA@@U.DECL-PX.SG2@%>сьыд SPAT_COMPARATIVE ;
@U.DECL-CX.APR@@U.DECL-PX.SG2@+Apr+PxSg2+So/CP:@U.DECL-CX.APR@@U.DECL-PX.SG2@%>ланьыд SPAT_COMPARATIVE ;
@U.DECL-CX.EGR@@U.DECL-PX.SG2@+Egr+PxSg2+So/CP:@U.DECL-CX.EGR@@U.DECL-PX.SG2@%>сяньыд SPAT_COMPARATIVE ;
@U.DECL-CX.TRA@@U.DECL-PX.SG2@+Tra+PxSg2+So/CP:@U.DECL-CX.TRA@@U.DECL-PX.SG2@%>тіыд COMPARATIVE ;
