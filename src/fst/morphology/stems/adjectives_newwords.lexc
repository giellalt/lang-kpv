!! This is where new words are added as lexc entries before they are 
!! added to the xml source files.
!! важ+A:важ A_ "(eng) /(fin)/(rus) " ;


LEXICON A_NEWWORDS
test+A:test A_ "(eng) /(fin) /(rus) " ;
